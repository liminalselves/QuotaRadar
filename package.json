{
  "name": "quotaradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file=.env --import tsx --watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "node --env-file=.env --import tsx apps/server/src/main.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build",
    "qq:up": "node scripts/stack.mjs up",
    "qq:down": "node scripts/stack.mjs down",
    "qq:status": "node scripts/stack.mjs status"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "fastify": "^5.6.0",
    "grammy": "^1.38.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
