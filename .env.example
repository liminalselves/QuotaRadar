# Source runs: node scripts/setup.mjs generates .env. Image deployments: set a long random admin password below.
QR_ADMIN_PASSWORD=
QR_BIND_ADDRESS=127.0.0.1
QR_PORT=3210
# Server deployments pull this image; scripts/stack.mjs builds a local image instead.
QUOTARADAR_IMAGE=ghcr.io/liminalselves/quotaradar:latest
# Documented release example; verify against official releases before changing.
SNOWLUMA_IMAGE=motricseven7/snowluma:v1.10.0
